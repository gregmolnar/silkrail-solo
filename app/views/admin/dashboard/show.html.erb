<% content_for :title, "Overview" %><div class="flex items-end justify-between"><div><p class="text-sm font-semibold text-emerald-700">Dashboard</p><h1 class="mt-1 text-3xl font-black">Welcome back, <%= Current.user.name %></h1></div><%= link_to "+ New product", new_admin_product_path, class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white" %></div>
<div class="mt-8 grid gap-4 sm:grid-cols-3"><% [["Revenue", humanized_money_with_symbol(@revenue)], ["Sales", @sales_count], ["Products", @products_count]].each do |label, value| %><div class="rounded-2xl border border-slate-200 bg-white p-6"><p class="text-sm text-slate-500"><%= label %></p><p class="mt-2 text-3xl font-black"><%= value %></p></div><% end %></div>
<div class="mt-10"><div class="flex justify-between"><h2 class="text-xl font-bold">Recent sales</h2><%= link_to "View all", admin_purchases_path, class: "text-sm font-semibold underline" %></div><div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white"><% @recent_purchases.each do |purchase| %><div class="flex justify-between border-b border-slate-100 px-5 py-4 last:border-0"><div><p class="font-semibold"><%= purchase.product.name %></p><p class="text-sm text-slate-500"><%= purchase.email %></p></div><div class="text-right"><p class="font-semibold"><%= humanized_money_with_symbol purchase.amount %></p><p class="text-xs text-slate-500"><%= time_ago_in_words(purchase.created_at) %> ago</p></div></div><% end %><% if @recent_purchases.empty? %><p class="p-8 text-center text-slate-500">Your first sale will appear here.</p><% end %></div></div>
