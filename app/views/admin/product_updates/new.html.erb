<%= link_to "← Customer updates", admin_product_product_updates_path(@product), class: "text-sm text-slate-500" %><h1 class="mt-3 text-3xl font-black">Email product customers</h1><p class="mt-2 text-slate-500">This will be sent to <%= pluralize @product.purchases.distinct.count(:email), "customer" %>. Messages are queued for background delivery.</p><%= form_with model: [:admin, @product, @product_update], class: "mt-8 max-w-2xl space-y-6" do |form| %><%= render "shared/errors", object: @product_update %><div><%= form.label :subject, class: "text-sm font-semibold" %><%= form.text_field :subject, required: true, class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><div><%= form.label :body, "Message", class: "text-sm font-semibold" %><%= form.lexxy_rich_textarea :body, required: true, class: "mt-2" %></div><div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900">Sending cannot be undone. Customers are deduplicated by email address.</div><%= form.submit "Queue email update", data: { turbo_confirm: "Send this update to all customers of #{@product.name}?" }, class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white" %><% end %>
