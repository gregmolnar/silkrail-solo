<div class="flex items-end justify-between gap-4"><div><%= link_to "← #{@product.name}", edit_admin_product_path(@product), class: "text-sm text-slate-500" %><h1 class="mt-3 text-3xl font-black">Customer updates</h1><p class="mt-2 text-slate-500">Email everyone who purchased this product.</p></div><%= link_to "Compose update", new_admin_product_product_update_path(@product), class: "rounded-lg bg-slate-950 px-4 py-2 font-bold text-white" %></div><div class="mt-8 overflow-hidden rounded-2xl border bg-white"><% @product_updates.each do |update| %><div class="border-b p-5 last:border-0"><div class="flex justify-between gap-4"><p class="font-bold"><%= update.subject %></p><p class="text-sm text-slate-500"><%= update.sent_at ? "Sent #{update.sent_at.to_fs(:short)}" : "Queued" %></p></div><p class="mt-2 line-clamp-2 text-sm text-slate-600"><%= update.body.to_plain_text %></p></div><% end %><% if @product_updates.empty? %><p class="p-10 text-center text-slate-500">No customer updates have been sent.</p><% end %></div>
