<div class="flex items-center justify-between"><div><%= link_to "← #{@product.name}", edit_admin_product_path(@product), class: "text-sm text-slate-500" %><h1 class="mt-3 text-3xl font-black">Discount codes</h1></div><%= link_to "+ New code", new_admin_product_discount_code_path(@product), class: "rounded-lg bg-slate-950 px-4 py-2 font-bold text-white" %></div><div class="mt-8 overflow-hidden rounded-2xl border bg-white"><% @discount_codes.each do |discount| %><div class="flex items-center justify-between border-b p-5 last:border-0"><div><p class="font-mono font-bold"><%= discount.code %></p><p class="text-sm text-slate-500"><%= discount.percent_off %>% off · <%= discount.redemptions_count %><%= "/#{discount.max_redemptions}" if discount.max_redemptions %> used<%= " · expired" unless discount.available? %></p></div><%= link_to "Edit", edit_admin_product_discount_code_path(@product, discount), class: "font-semibold text-emerald-700" %></div><% end %><% if @discount_codes.empty? %><p class="p-10 text-center text-slate-500">No discount codes yet.</p><% end %></div>
