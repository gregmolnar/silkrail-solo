<%= form_with model: [:admin, product, discount_code], class: "mt-8 max-w-xl space-y-6" do |form| %><%= render "shared/errors", object: discount_code %><div><%= form.label :code, class: "text-sm font-semibold" %><%= form.text_field :code, required: true, class: "mt-2 w-full rounded-lg border px-3 py-2 font-mono uppercase" %></div><div><%= form.label :percent_off, class: "text-sm font-semibold" %><%= form.number_field :percent_off, min: 1, max: 100, required: true, class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><div><%= form.label :max_redemptions, "Maximum redemptions (optional)", class: "text-sm font-semibold" %><%= form.number_field :max_redemptions, min: 1, class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><div><%= form.label :expires_at, "Expires at (optional)", class: "text-sm font-semibold" %><%= form.datetime_local_field :expires_at, class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><%= form.submit "Save discount", class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white" %><% end %>
