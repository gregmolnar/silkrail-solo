<div class="flex items-end justify-between gap-4"><div><h1 class="text-3xl font-black"><%= @product ? "Sales of #{@product.name}" : "Sales" %></h1><p class="mt-1 text-slate-500">Stripe checkouts and imported Gumroad purchases.</p></div><% if @product %><div class="flex gap-3"><%= link_to "Add purchase", new_admin_product_purchase_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-bold" %><%= link_to "Import from Gumroad", import_admin_product_purchases_path(@product), class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white" %></div><% end %></div><div class="mt-8 overflow-x-auto rounded-2xl border bg-white"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-4">Customer</th><th class="p-4">Product</th><th class="p-4">Source</th><th class="p-4">Amount</th><th class="p-4">Date</th></tr></thead><tbody><% @purchases.each do |purchase| %><tr class="border-t"><td class="p-4"><%= link_to purchase.email, admin_purchase_path(purchase), class: "font-semibold" %></td><td class="p-4"><%= purchase.product.name %></td><td class="p-4 capitalize text-slate-500"><%= purchase.source %></td><td class="p-4"><%= humanized_money_with_symbol purchase.amount %></td><td class="p-4 text-slate-500"><%= purchase.created_at.to_fs(:short) %></td></tr><% end %></tbody></table><% if @purchases.empty? %><p class="p-10 text-center text-slate-500">No sales yet.</p><% end %></div>
