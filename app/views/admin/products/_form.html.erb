<%= form_with model: [:admin, product], class: "mt-8 max-w-3xl space-y-6" do |form| %><%= render "shared/errors", object: product %>
<div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :name, class: "text-sm font-semibold" %><%= form.text_field :name, required: true, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div><div><%= form.label :slug, class: "text-sm font-semibold" %><%= form.text_field :slug, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div></div>
<div><%= form.label :status, class: "text-sm font-semibold" %><%= form.select :status, Product.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div>
<div><%= form.label :summary, class: "text-sm font-semibold" %><%= form.text_field :summary, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2", placeholder: "A short sales pitch" %></div>
<div><%= form.label :description, class: "text-sm font-semibold" %><%= form.lexxy_rich_textarea :description, class: "lexxy-content mt-2 min-h-80 rounded-lg border border-slate-300 bg-white" %></div>
<div><%= form.label :price, class: "text-sm font-semibold" %><div class="mt-2 flex items-center gap-2"><span>$</span><%= form.number_field :price, min: 0, step: 0.01, class: "w-48 rounded-lg border border-slate-300 px-3 py-2" %></div></div>
<div><%= form.label :cover, class: "text-sm font-semibold" %><p class="mt-1 text-sm text-slate-500">Use a 3:1 image to match the storefront hero. Recommended size: 1500×500 px or 1200×400 px.</p><%= form.file_field :cover, accept: "image/*", class: "mt-2 block text-sm" %><% if product.persisted? && product.cover.attachment&.persisted? && product.cover.blob&.persisted? %><%= image_tag product.cover, class: "mt-3 h-28 rounded-lg object-cover" %><% end %></div>
<div><%= form.label :custom_css, "Product page CSS", class: "text-sm font-semibold" %><p class="mt-1 text-sm text-slate-500">Applied after the general storefront CSS. The default value documents every product-page selector available to style.</p><%= form.textarea :custom_css, rows: 22, spellcheck: false, class: "mt-2 w-full rounded-lg border border-slate-300 bg-slate-950 px-4 py-3 font-mono text-sm text-slate-100" %></div>
<%= form.submit "Save product", class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white" %><% end %>
