<div class="flex items-center justify-between"><div><h1 class="text-3xl font-black">Products</h1><p class="mt-1 text-slate-500">Create and publish your digital goods.</p></div><%= link_to "+ New product", new_admin_product_path, class: "rounded-lg bg-slate-950 px-4 py-2 font-bold text-white" %></div>
<div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white"><% @products.each do |product| %><div class="flex flex-col justify-between gap-4 border-b border-slate-100 p-5 last:border-0 sm:flex-row sm:items-center"><div><div class="flex items-center gap-3"><h2 class="font-bold"><%= product.name %></h2><span class="rounded-full px-2 py-1 text-xs font-semibold <%= product.published? ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>"><%= product.status %></span></div><p class="mt-1 text-sm text-slate-500"><%= humanized_money_with_symbol product.price %> · <%= product.purchases.count %> sales</p></div><div class="flex gap-3 text-sm font-semibold"><%= link_to "View", store_product_path(product.slug), target: "_blank" %><%= link_to "Sales", admin_purchases_path(product_id: product.id) %><%= link_to "Add purchase", new_admin_product_purchase_path(product) %><%= link_to "Import Gumroad", import_admin_product_purchases_path(product) %><%= link_to "Edit", edit_admin_product_path(product), class: "text-emerald-700" %></div></div><% end %><% if @products.empty? %><p class="p-12 text-center text-slate-500">Create your first product to get started.</p><% end %></div>
