<div class="flex flex-wrap items-end justify-between gap-4"><div><%= link_to "← Products", admin_products_path, class: "text-sm text-slate-500" %><h1 class="mt-3 text-3xl font-black">Edit <%= @product.name %></h1></div><div class="flex gap-2"><%= link_to "Releases", admin_product_releases_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %><%= link_to "Discounts", admin_product_discount_codes_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %><%= link_to "Email customers", admin_product_product_updates_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %><%= link_to "Add purchase", new_admin_product_purchase_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %><%= link_to "Import Gumroad sales", import_admin_product_purchases_path(@product), class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %><%= link_to "Preview", store_product_path(@product.slug), target: "_blank", class: "rounded-lg border bg-white px-4 py-2 text-sm font-semibold" %></div></div><%= render "form", product: @product %><div class="mt-12 border-t pt-6"><%= button_to "Delete product", admin_product_path(@product), method: :delete, data: { turbo_confirm: "Delete this product?" }, class: "text-sm font-semibold text-red-700" %></div>
