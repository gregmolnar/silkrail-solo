<%= link_to "← Sales", admin_purchases_path(product_id: @product), class: "text-sm text-slate-500" %>
<h1 class="mt-3 text-3xl font-black">Add purchase</h1>
<p class="mt-2 text-slate-500"><%= @product.name %></p>

<%= form_with url: admin_product_purchases_path(@product), scope: :purchase, class: "mt-8 max-w-2xl space-y-6 rounded-2xl border border-slate-200 bg-white p-6" do |form| %>
  <%= render "shared/errors", object: @purchase %>

  <div>
    <%= form.label :email, "Customer email", class: "text-sm font-semibold" %>
    <%= form.email_field :email, value: @purchase.email, required: true, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :amount, "Amount", class: "text-sm font-semibold" %>
    <div class="mt-2 flex items-center gap-2">
      <span class="uppercase text-slate-500"><%= store.currency %></span>
      <%= form.number_field :amount, value: format("%.2f", @purchase.amount_cents.to_i / 100.0), min: 0, step: 0.01, required: true, class: "w-48 rounded-lg border border-slate-300 px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= form.label :source, class: "text-sm font-semibold" %>
    <%= form.select :source, Purchase.sources.except("stripe").keys.map { |source| [source.humanize, source] }, { selected: @purchase.source }, class: "mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2" %>
    <p class="mt-1 text-sm text-slate-500">Stripe purchases are created automatically by Checkout and cannot be entered manually.</p>
  </div>

  <div>
    <%= form.label :purchased_at, "Purchase date", class: "text-sm font-semibold" %>
    <%= form.datetime_local_field :purchased_at, value: @purchased_at&.strftime("%Y-%m-%dT%H:%M"), class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :external_id, "Reference ID (optional)", class: "text-sm font-semibold" %>
    <%= form.text_field :external_id, value: @purchase.external_id, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2", placeholder: "Invoice, order, or support reference" %>
  </div>

  <label class="flex items-start gap-3">
    <%= form.check_box :send_receipt, class: "mt-1 size-4 rounded border-slate-300" %>
    <span>
      <span class="block text-sm font-semibold">Email the receipt and download link</span>
      <span class="mt-1 block text-sm text-slate-500">Leave unchecked when recording a purchase the customer already knows about.</span>
    </span>
  </label>

  <%= form.submit "Add purchase", class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white hover:bg-emerald-700" %>
<% end %>
