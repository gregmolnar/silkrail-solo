<div class="flex items-end justify-between gap-4">
  <div>
    <%= link_to "← Sales", admin_purchases_path(product_id: @product), class: "text-sm text-slate-500" %>
    <h1 class="mt-3 text-3xl font-black">Import purchases</h1>
    <p class="mt-2 text-slate-500"><%= @product.name %></p>
  </div>
</div>

<div class="mt-8 max-w-2xl rounded-2xl border border-slate-200 bg-white p-6">
  <h2 class="text-lg font-bold">Gumroad CSV</h2>
  <p class="mt-2 text-sm leading-6 text-slate-600">
    Export your sales from Gumroad and upload the CSV here. Only rows whose
    <strong>Item Name</strong> exactly matches <strong><%= @product.name %></strong>
    will be imported. Buyers receive access to all published releases, but no receipt email is sent during import.
  </p>

  <%= form_with url: import_admin_product_purchases_path(@product), multipart: true, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :gumroad_csv, "Choose Gumroad CSV", class: "block text-sm font-semibold" %>
      <%= form.file_field :gumroad_csv, accept: ".csv,text/csv", required: true, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm file:mr-4 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:font-semibold" %>
    </div>
    <%= form.submit "Import purchases", class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white hover:bg-emerald-700" %>
  <% end %>
</div>
