<%= form_with model: [:admin, product, release], class: "mt-8 max-w-3xl space-y-6" do |form| %><%= render "shared/errors", object: release %><div><%= form.label :name, class: "text-sm font-semibold" %><%= form.text_field :name, required: true, placeholder: "Version 1.0", class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><div><%= form.label :status, class: "text-sm font-semibold" %><%= form.select :status, Release.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "mt-2 w-full rounded-lg border px-3 py-2" %></div><div><%= form.label :notes, "Release notes", class: "text-sm font-semibold" %><%= form.lexxy_rich_textarea :notes, class: "mt-2" %></div><% if release.files.attached? %><div><p class="text-sm font-semibold">Current files</p><% release.files.attachments.each do |file| %><label class="mt-2 flex gap-2 text-sm"><%= check_box_tag "release[remove_file_ids][]", file.id %> Remove <%= file.filename %></label><% end %></div><% end %><div><%= form.label :files, class: "text-sm font-semibold" %><p class="mt-1 text-sm text-slate-500">Files upload directly to storage before the release is saved, so large uploads can complete without tying up the web request.</p><%= form.file_field :files, multiple: true, direct_upload: true, class: "mt-2 block" %></div><%= form.submit "Save release", class: "cursor-pointer rounded-lg bg-emerald-600 px-5 py-2.5 font-bold text-white" %><% end %>
