<div class="flex items-center justify-between"><div><%= link_to "← #{@product.name}", edit_admin_product_path(@product), class: "text-sm text-slate-500" %><h1 class="mt-3 text-3xl font-black">Releases</h1></div><%= link_to "+ New release", new_admin_product_release_path(@product), class: "rounded-lg bg-slate-950 px-4 py-2 font-bold text-white" %></div><div class="mt-8 overflow-hidden rounded-2xl border bg-white"><% @releases.each do |release| %><div class="flex items-center justify-between border-b p-5 last:border-0"><div><p class="font-bold"><%= release.name %></p><p class="text-sm text-slate-500"><%= release.status %> · <%= pluralize release.files.count, "file" %></p></div><%= link_to "Edit", edit_admin_product_release_path(@product, release), class: "font-semibold text-emerald-700" %></div><% end %><% if @releases.empty? %><p class="p-10 text-center text-slate-500">Add a release and attach the files buyers receive.</p><% end %></div>
