<% content_for :title, "Download #{@purchase.product.name}" %>
<div class="mx-auto max-w-3xl">
  <p class="store-eyebrow text-sm font-bold uppercase tracking-widest">Your purchase</p>
  <h1 class="mt-3 text-4xl font-black"><%= @purchase.product.name %></h1>
  <p class="mt-3 text-slate-600">
    Purchased <%= @purchase.created_at.to_fs(:long) %> for
    <%= humanized_money_with_symbol @purchase.amount %>.
  </p>

  <div class="mt-10">
    <% if @latest_release %>
      <section class="release-card rounded-2xl border border-slate-900/10 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Latest release</p>
        <h2 class="mt-2 text-xl font-bold"><%= @latest_release.name %></h2>
        <div class="lexxy-content mt-3"><%= @latest_release.notes %></div>

        <% if @latest_release.files.attached? %>
          <div class="mt-5 space-y-2">
            <% @latest_release.files.each do |file| %>
              <%= link_to purchase_download_path(@purchase.access_token, file.id), class: "flex items-center justify-between gap-4 rounded-lg bg-slate-950 px-4 py-3 font-semibold text-white hover:bg-slate-800" do %>
                <span>Download <%= file.filename %></span>
                <span class="shrink-0 text-sm font-normal text-slate-300"><%= number_to_human_size(file.byte_size) %></span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-5 rounded-lg bg-amber-50 p-4 text-sm text-amber-800">Files for this release are being prepared.</p>
        <% end %>
      </section>
    <% else %>
      <p class="rounded-xl bg-white p-6 text-slate-600">Files are being prepared. Please check again soon.</p>
    <% end %>
  </div>

  <section class="mt-8 rounded-2xl border border-slate-900/10 bg-white p-6">
    <h2 class="text-lg font-bold">How was it?</h2>
    <p class="mt-1 text-sm text-slate-600">Share a testimonial to help other customers.</p>
    <%= testimonials_button label: "Leave a review", class: "mt-4 cursor-pointer rounded-lg border border-slate-900 px-4 py-2 text-sm font-bold hover:bg-slate-50" %>
  </section>
</div>
