<% content_for :title, "Customer sign in · #{store.name}" %>
<div class="mx-auto max-w-md py-12">
  <h1 class="text-3xl font-black">Access your purchases</h1>
  <p class="mt-2 text-slate-600">Sign in with the email used at checkout.</p>
  <%= form_with url: account_session_path, class: "mt-8 space-y-5" do |form| %>
    <div><%= form.label :email_address, class: "block text-sm font-semibold" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div>
    <div><div class="flex justify-between"><%= form.label :password, class: "text-sm font-semibold" %><%= link_to "Forgot password?", new_account_password_path, class: "text-sm font-semibold text-emerald-700" %></div><%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div>
    <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-slate-950 px-4 py-2.5 font-bold text-white" %>
  <% end %>
</div>
