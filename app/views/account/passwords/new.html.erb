<% content_for :title, "Reset password · #{store.name}" %>
<div class="mx-auto max-w-md py-12"><h1 class="text-3xl font-black">Reset your password</h1><p class="mt-2 text-slate-600">We will email a reset link to the address used for your purchase.</p><%= form_with url: account_passwords_path, class: "mt-8 space-y-5" do |form| %><div><%= form.label :email_address, class: "block text-sm font-semibold" %><%= form.email_field :email_address, required: true, autofocus: true, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div><%= form.submit "Send reset link", class: "w-full cursor-pointer rounded-lg bg-slate-950 px-4 py-2.5 font-bold text-white" %><% end %></div>
