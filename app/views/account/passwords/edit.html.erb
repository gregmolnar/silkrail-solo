<% content_for :title, "Choose a password · #{store.name}" %>
<div class="mx-auto max-w-md py-12"><h1 class="text-3xl font-black">Choose a new password</h1><%= form_with url: account_password_path(params[:token]), method: :put, class: "mt-8 space-y-5" do |form| %><%= render "shared/errors", object: @customer %><div><%= form.label :password, class: "block text-sm font-semibold" %><%= form.password_field :password, required: true, minlength: 10, autocomplete: "new-password", class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div><div><%= form.label :password_confirmation, class: "block text-sm font-semibold" %><%= form.password_field :password_confirmation, required: true, minlength: 10, autocomplete: "new-password", class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %></div><%= form.submit "Save password", class: "w-full cursor-pointer rounded-lg bg-slate-950 px-4 py-2.5 font-bold text-white" %><% end %></div>
