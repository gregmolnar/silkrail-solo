<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "#{store.name} Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full text-slate-900">
    <% if Current.user %>
      <div class="min-h-screen lg:flex">
        <aside class="bg-slate-950 px-5 py-5 text-white lg:fixed lg:inset-y-0 lg:w-64">
          <%= link_to store.name, admin_root_path, class: "block text-xl font-bold tracking-tight" %>
          <p class="mt-1 text-xs text-slate-400">Your independent storefront</p>
          <nav class="mt-8 flex gap-2 overflow-x-auto lg:flex-col">
            <%= link_to "Overview", admin_root_path, class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "Products", admin_products_path, class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "Sales", admin_purchases_path, class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "Jobs", "/jobs", class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "Testimonials", testimonials.testimonials_path, class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "Settings", edit_admin_settings_path, class: "rounded-lg px-3 py-2 text-sm hover:bg-slate-800" %>
            <%= link_to "View store ↗", root_path, class: "rounded-lg px-3 py-2 text-sm text-emerald-300 hover:bg-slate-800", target: "_blank" %>
          </nav>
          <%= button_to "Sign out", session_path, method: :delete, class: "mt-8 text-sm text-slate-400 hover:text-white" %>
        </aside>
        <main class="w-full px-5 py-8 lg:ml-64 lg:px-10">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="min-h-screen"><%= render "shared/flash" %><%= yield %></main>
    <% end %>
  </body>
</html>
