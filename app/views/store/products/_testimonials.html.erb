<% if testimonials.any? %>
  <section class="product-testimonials mt-14 border-t border-slate-900/10 pt-10">
    <h2 class="text-2xl font-black tracking-tight">What customers say</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <% testimonials.each do |testimonial| %>
        <figure class="testimonial-card rounded-2xl border border-slate-900/10 bg-white p-5 shadow-sm">
          <% if testimonial.rating %>
            <div class="testimonial-stars text-lg tracking-wider text-amber-500" aria-label="<%= testimonial.rating %> out of 5 stars"><%= "★" * testimonial.rating %><span class="text-slate-200"><%= "★" * (5 - testimonial.rating) %></span></div>
          <% end %>
          <% if testimonial.video_attached? %>
            <video controls preload="metadata" class="mt-4 aspect-video w-full rounded-xl bg-black"<% if testimonial.poster_attached? %> poster="<%= testimonials.testimonial_poster_path(testimonial) %>"<% end %> src="<%= testimonials.testimonial_video_path(testimonial) %>"></video>
          <% end %>
          <% if testimonial.quote.present? %>
            <blockquote class="testimonial-quote mt-4 leading-7 text-slate-700">“<%= testimonial.quote %>”</blockquote>
          <% end %>
          <figcaption class="testimonial-author mt-5 flex items-center gap-3 text-sm">
            <% if testimonial.avatar_attached? %>
              <%= image_tag testimonials.testimonial_avatar_path(testimonial), alt: "", class: "size-10 rounded-full object-cover" %>
            <% end %>
            <span>
              <strong class="block font-bold text-slate-900"><%= testimonial.name %></strong>
              <% if testimonial.title_company.present? %><span class="text-slate-500"><%= testimonial.title_company %></span><% end %>
            </span>
          </figcaption>
        </figure>
      <% end %>
    </div>
  </section>
<% end %>
