# Application
APP_HOST=shop.example.com
# Kamal reads config/master.key directly; set this for non-Kamal production commands.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
FORCE_SSL=true
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true

# Owner created by bin/rails db:seed
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=use-a-long-random-password
ADMIN_NAME="Store owner"
STORE_NAME="My Store"
STORE_DESCRIPTION="Independent digital goods, sold directly."
STORE_SUPPORT_EMAIL=support@example.com

# Stripe — your own account, no Connect platform required
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
MAIL_FROM=downloads@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=...
SMTP_PASSWORD=...

# Private S3-compatible Active Storage (AWS, R2, Spaces, B2, MinIO, etc.)
ACTIVE_STORAGE_SERVICE=s3
# Use the provider endpoint without the bucket name (for example,
# https://ams3.digitaloceanspaces.com, not https://my-bucket.ams3.digitaloceanspaces.com).
S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
S3_REGION=auto
S3_BUCKET=silkrail
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# Local Docker database (docker compose up -d)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=silkrail_solo
DATABASE_PASSWORD=password

# Production PostgreSQL database (app, cache, and queue tables share it)
DATABASE_URL=postgresql://user:password@database.example.com/silkrail_production

# Kamal application and server
KAMAL_SERVICE=silkrail-solo
KAMAL_IMAGE=silkrail-solo
KAMAL_WEB_HOSTS=203.0.113.10
# Used when SOLID_QUEUE_IN_PUMA=false; defaults to KAMAL_WEB_HOSTS when blank/unset.
KAMAL_JOB_HOSTS=203.0.113.10
KAMAL_SSH_USER=root
KAMAL_BUILDER_ARCH=amd64
KAMAL_STORAGE_VOLUME=silkrail-solo-storage

# Kamal Proxy
KAMAL_PROXY_SSL=true

# Container registry — defaults to a local unauthenticated registry
KAMAL_REGISTRY_SERVER=localhost:5555
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
